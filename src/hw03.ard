\import Data.List
\import Function.Meta
\import Paths
\import lect03
\open Nat(+, *)

-- 1. Чему равно fileTest (в нормальной форме)? Докажите это

\func fileTest_n => (17, 8, 13, 55, 18, 21)
\func fileTest_check : fileTest = fileTest_n => idp

-- 2. Чему равно M5.t''' (в нормальной форме)? Докажите это

\func t_n => ((82, 42, 61, 82, 34, 42, 61, 29), 25, (42, 29))
\func check_t : M5.t''' = t_n => idp

-- 3. Докажите ассоциативность ++

\func ++-assoc {A : \Type} (xs ys zs : List A) : (xs ++ ys) ++ zs = xs ++ (ys ++ zs) \elim xs
  | nil => idp
  | :: x xs => pmap (x `::) $ ++-assoc xs ys zs


\func sum (xs : List Nat) : Nat
  | nil => 0
  | :: x xs => x + sum xs

-- 4. Докажите, что sum (reverse xs) = sum xs, где reverse определен через ++

\func reverse {A : \Type} (xs : List A) : List A
  | nil => nil
  | :: x xs => reverse xs ++ x :: nil

-- Это утверждение будет полезно для доказательства
\func sum++ (xs ys : List Nat) : sum (xs ++ ys) = sum xs + sum ys \elim xs
  | nil => idp
  | :: x xs =>
    \let | step_1 => pmap (x `+) $ sum++ xs ys
         | step_2 => sym' $ +-assoc x (sum xs) (sum ys)
    \in step_1 *> step_2

\func sum-reverse (xs : List Nat) : sum (reverse xs) = sum xs \elim xs
  | nil => idp
  | :: x xs =>
    \let | step_1 => sum++ (reverse xs) (x :: nil)
         | step_2 => +-comm (sum $ reverse xs) x
         | step_3 => pmap (x +) $ sum-reverse xs
    \in step_1 *> step_2 *> step_3

-- 5. Докажите дистрибутивность умножения над сложением для натуральных чисел

\func rdistr (n m k : Nat) : (m + k) * n = m * n + k * n \elim n
  | 0 => idp
  | suc n =>
    \let | step_1 => pmap (`+ (m + k)) $ rdistr n m k
         | step_2 => sym' $ +-assoc (m * n + k * n) m k
         | step_3 => pmap (`+ k) $ +-assoc (m * n) (k * n) m
         | step_4 => pmap (`+ k) $ pmap ((m * n) `+) $ +-comm (k * n) m
         | step_5 => sym' $ pmap (`+ k) $ +-assoc (m * n) m (k * n)
         | step_6 => +-assoc (m * n + m) (k * n) k
    \in step_1 *> step_2 *> step_3 *> step_4 *> step_5 *> step_6

\func ldistr (n m k : Nat) : n * (m + k) = n * m + n * k \elim m, k
  | 0, 0 => idp
  | 0, k => idp
  | m, 0 => idp
  | suc m, suc k =>
    \let | step_1 => pmap (`+ n) $ pmap (`+ n ) $ ldistr n m k
         | step_2 => pmap (`+ n) $ +-assoc (n * m) (n * k) n
         | step_3 => +-assoc (n * m) (n * k + n) n
         | step_4 => pmap (n * m `+) $ +-comm (n * k + n) n
         | step_5 => pmap (n * m `+) $ sym' $ +-assoc n (n * k) n
         | step_6 => sym' $ +-assoc (n * m) (n + n * k) n
         | step_7 => pmap (`+ n) $ sym' $ +-assoc (n * m) n (n * k)
         | step_8 => +-assoc (n * m + n) (n * k) n
    \in step_1 *> step_2 *> step_3 *> step_4 *> step_5 *> step_6 *> step_7 *> step_8

-- 6. Определите конгруэнтность для функций двух аргументов через transport
--    Можно использовать любые функции, определенные через transport

\func pmap2 {A B C : \Type} (f : A -> B -> C) {a a' : A} (p : a = a') {b b' : B} (q : b = b')
  : f a b = f a' b' =>
  \let | step_1 => transport (f a b = f a __) q idp
       | step_2 => transport (f a b' = f __ b') p idp
  \in trans step_1 step_2

-- 7. Докажите, что transport выражается через pmap и repl и наоборот

-- repl говорит, что если у нас есть два равных типа, то у нас есть функция из одного во второй
-- Определите repl через transport

\func repl {A B : \Type} (p : A = B) (a : A) : B => transport (\lam x => x) p a

-- Определите transport через repl и pmap

\func transport' {A : \Type} (B : A -> \Type) {a a' : A} (p : a = a') (b : B a) : B a' =>
  repl (pmap B p) b
